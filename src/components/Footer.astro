---
import { DISCORD_INVITE_URL } from '../data/discord';
---

<footer>
  <p>
    O TibiaNerd é um site de fãs, sem vínculo com a CipSoft. O{' '}
    <a href="https://www.tibia.com" rel="noopener">Tibia</a> é feito pela{' '}
    <a href="https://www.cipsoft.com" rel="noopener">CipSoft</a>, e todo
    conteúdo oficial, incluindo gráficos, tem copyright da CipSoft. Dados de
    criaturas e ícones da{' '}
    <a href="https://tibia.fandom.com" rel="noopener">TibiaWiki</a>, sob a
    licença
    <a href="https://creativecommons.org/licenses/by-sa/3.0/" rel="noopener">
      CC-BY-SA</a
    >.
  </p>
  <p class="links">
    <a href="/privacidade/">Privacidade</a> ·
    <a href={DISCORD_INVITE_URL} rel="noopener">Discord</a>
  </p>
</footer>

<style>
  footer {
    border-block-start: 2px solid var(--color-line);
    padding-block: var(--space-6);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  p {
    max-inline-size: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .links {
    margin-block-start: var(--space-2);
  }
</style>
