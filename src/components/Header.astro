---
import { tools } from '../data/tools';

const { pathname } = Astro.url;
const currentPath = `${pathname.replace(/\/$/, '')}/`;
// The home cards already list every tool.
const isHome = pathname === '/';
---

<header>
  <a class="logo" href="/">TibiaNerd</a>
  {
    !isHome && (
      <nav aria-label="Ferramentas">
        <button class="menu-button" type="button" popovertarget="tool-menu">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path
              d="M2 4h14M2 9h14M2 14h14"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
          Menu
        </button>
        <ul id="tool-menu" popover="auto">
          {tools.map(({ href, shortName, usesAccount }) => (
            <li>
              <a
                href={href}
                data-astro-prefetch={usesAccount ? 'false' : undefined}
                aria-current={currentPath.startsWith(href) ? 'page' : undefined}
              >
                {shortName}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <a
    class="account"
    href="/conta/"
    data-account-link
    data-astro-prefetch="false">Entrar</a
  >
  <script is:inline>
    // Shows the saved account without asking the server on every page.
    try {
      const name = localStorage.getItem('tibianerd:account');
      const image = localStorage.getItem('tibianerd:account-image');
      const link = document.querySelector('[data-account-link]');

      if (name) {
        link.textContent = name;
      }

      if (name && image) {
        const photo = new Image(32, 32);
        const label = document.createElement('span');

        label.textContent = name;
        photo.alt = '';
        photo.src = image;
        photo.onerror = () => photo.remove();
        link.setAttribute('aria-label', `Sua conta: ${name}`);
        link.dataset.avatar = '';
        link.replaceChildren(photo, label);
      }
    } catch {}
  </script>
</header>

<style>
  header {
    position: sticky;
    inset-block-start: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-2) max(var(--page-gutter), calc((100% - var(--page-max)) / 2 + var(--page-gutter)));
    border-block-end: 1px solid var(--color-line);
    /* A translucent sticky bar can change how the browser smooths its text. */
    background: var(--color-background);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-target);
    color: var(--color-text);
    font-family: var(--font-logo);
    font-size: var(--text-xl);
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    min-inline-size: 0;
  }

  .account {
    flex: none;
    display: inline-flex;
    align-items: center;
    max-inline-size: 9rem;
    min-block-size: var(--tap-target);
    padding-inline: var(--space-3);
    overflow: hidden;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-small);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .account[data-avatar] {
    gap: var(--space-2);
    padding-inline: var(--space-1) var(--space-2);
    border-color: var(--color-line);
    border-radius: 999px;
    color: var(--color-text);
  }

  .account[data-avatar]:hover {
    border-color: var(--color-accent);
    background: transparent;
    color: var(--color-text);
  }

  .account :global(img) {
    flex: none;
    border-radius: 50%;
  }

  .account :global(span) {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .menu-button {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--tap-target);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-small);
    background: transparent;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }

  /* Undoes the browser's popover styles while the menu sits in the header. */
  ul {
    position: static;
    display: flex;
    gap: var(--space-1);
    inline-size: auto;
    block-size: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    list-style: none;
    overflow: visible;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.25rem;
    padding-inline: var(--space-3);
    border-radius: var(--radius-small);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--color-raised);
    color: var(--color-text);
  }

  @media (min-width: 56rem) {
    nav {
      flex: 1;
    }
  }

  /* The five tool names do not fit next to the logo on a phone. */
  @media (max-width: 55.99rem) {
    header {
      gap: var(--space-2);
    }

    .logo {
      margin-inline-end: auto;
    }

    .account {
      max-inline-size: 7rem;
    }

    .menu-button {
      display: inline-flex;
    }

    ul {
      position: fixed;
      inset: calc(var(--tap-target) + 2 * var(--space-2) + var(--space-1))
        var(--page-gutter) auto;
      flex-direction: column;
      padding: var(--space-2);
      border: 1px solid var(--color-line);
      border-radius: var(--radius);
      background: var(--color-raised);
      box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.5);
    }

    ul:not(:popover-open) {
      display: none;
    }

    nav a {
      display: flex;
      min-block-size: var(--tap-target);
      font-size: var(--text-md);
    }

    nav a:hover,
    nav a[aria-current='page'] {
      background: var(--color-line);
    }
  }
</style>
