---
import { tools } from '../data/tools';

const links = tools.filter((tool) => tool.href);
const { pathname } = Astro.url;
---

<header>
  <a class="logo" href="/">TibiaNerd</a>
  <nav aria-label="Ferramentas">
    <ul>
      {
        links.map(({ href, shortName }) => (
          <li>
            <a
              href={href}
              aria-current={pathname.startsWith(href!) ? 'page' : undefined}
            >
              {shortName}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  header {
    position: sticky;
    inset-block-start: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-6);
    padding: var(--space-2) max(var(--page-gutter), calc((100% - var(--page-max)) / 2 + var(--page-gutter)));
    border-block-end: 1px solid var(--color-line);
    background: rgb(12 14 20 / 0.92);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-target);
    color: var(--color-text);
    font-family: var(--font-logo);
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    min-inline-size: 0;
    overflow-x: auto;
  }

  ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.25rem;
    padding-inline: var(--space-3);
    border-radius: var(--radius-small);
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--color-raised);
    color: var(--color-text);
  }
</style>
