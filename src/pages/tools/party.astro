---
import PartyCalculator from '../../components/PartyCalculator';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Calculadora de party para Tibia | TibiaNerd"
  description="Veja se a sua party divide experiência no Tibia, o bônus por vocações e quais níveis podem entrar."
>
  <section class="intro">
    <h1>Calculadora de party</h1>
    <p>Veja se a party divide XP, o bônus e quem ainda pode entrar.</p>
  </section>

  <PartyCalculator client:load />
</BaseLayout>

<style>
  .intro {
    margin-block-end: var(--space-6);
  }

  h1 {
    font-size: var(--text-title);
  }

  p {
    margin-block-start: var(--space-2);
    font-size: var(--text-lg);
  }
</style>
