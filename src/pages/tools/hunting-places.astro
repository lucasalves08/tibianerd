---
import HuntFinder from '../../components/HuntFinder';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hunting places do Tibia por vocação e nível | TibiaNerd"
  description="Encontre spots de caça do Tibia por vocação, nível, cidade e melhor tipo de dano."
>
  <section class="intro">
    <h1>Hunting places</h1>
    <p>Encontre spots por vocação, nível e melhor tipo de dano.</p>
  </section>

  <HuntFinder client:load />
</BaseLayout>

<style>
  .intro {
    margin-block-end: var(--space-6);
  }

  h1 {
    font-size: var(--text-title);
  }

  p {
    margin-block-start: var(--space-2);
    font-size: var(--text-lg);
  }
</style>
