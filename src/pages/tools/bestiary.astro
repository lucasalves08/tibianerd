---
import BestiaryTracker from '../../components/BestiaryTracker';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Progresso do Bestiary do Tibia | TibiaNerd"
  description="Acompanhe suas mortes no Bestiary do Tibia e veja quantos Charm Points faltam."
>
  <section class="intro">
    <h1>Bestiary</h1>
    <p>Anote suas mortes e veja quantos Charm Points faltam.</p>
  </section>

  <BestiaryTracker client:load />
</BaseLayout>

<style>
  .intro {
    margin-block-end: var(--space-6);
  }

  h1 {
    font-size: clamp(1.75rem, 6vw, 3rem);
  }

  p {
    margin-block-start: var(--space-2);
    font-size: 1.125rem;
  }
</style>
