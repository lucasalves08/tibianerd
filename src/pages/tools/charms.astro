---
import CharmOptimizer from '../../components/CharmOptimizer';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Otimizador de charms para Tibia | TibiaNerd"
  description="Descubra o melhor charm para cada criatura da sua caçada, considerando resistências, HP, mortes e o seu nível."
>
  <section class="intro">
    <h1>Otimizador de charms</h1>
    <p>Informe seus charms e veja o melhor para cada criatura da caçada.</p>
  </section>

  <CharmOptimizer client:load />
</BaseLayout>

<style>
  .intro {
    margin-block-end: var(--space-6);
  }

  h1 {
    font-size: var(--text-title);
  }

  p {
    margin-block-start: var(--space-2);
    font-size: var(--text-lg);
  }
</style>
