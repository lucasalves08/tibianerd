---
import ToolGrid from '../components/ToolGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="TibiaNerd: ferramentas para Tibia"
  description="Calculadoras, charms, bestiário e hunts para Tibia. Abra e use, sem cadastro."
>
  <section class="hero">
    <h1>Deixa que o nerd faz a conta.</h1>
    <p>Ferramentas para Tibia, sem cadastro.</p>
  </section>

  <ToolGrid />
</BaseLayout>

<style>
  .hero {
    margin-block-end: var(--space-8);
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.25rem);
  }

  p {
    margin-block-start: var(--space-2);
    color: var(--color-muted);
    font-size: 1.125rem;
  }
</style>
